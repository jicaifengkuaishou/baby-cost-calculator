/* pages/fertility/fertility.wxss */
.fertility-page {
  padding-top: 80rpx;
}

.number-selector {
  margin-top: 20rpx;
}

.number-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.number-item {
  background: #F8F9FA;
  padding: 40rpx 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  color: #636E72;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.number-item.active {
  background: #E8E5FF;
  border-color: #6C5CE7;
  color: #6C5CE7;
  font-weight: 600;
  transform: scale(1.05);
}

.child-info {
  margin-top: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ECEFF1;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #636E72;
}

.picker-inline {
  background: #F8F9FA;
  padding: 12rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2D3436;
  font-weight: 600;
}

.tips-card {
  display: flex;
  align-items: flex-start;
  background: #E8F4FD;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-top: 30rpx;
}

.tips-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tips-text {
  flex: 1;
  font-size: 26rpx;
  color: #0C5AA6;
  line-height: 1.6;
}

.btn-group {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 20rpx;
  margin-top: 60rpx;
}

.btn-secondary {
  height: 100rpx;
  line-height: 100rpx;
  background: white;
  color: #6C5CE7;
  border: 2rpx solid #6C5CE7;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
