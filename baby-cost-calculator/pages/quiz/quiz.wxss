/* pages/quiz/quiz.wxss */
.quiz-page {
  padding-top: 80rpx;
}

.quiz-card {
  margin-bottom: 30rpx;
}

.quiz-question {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.quiz-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.quiz-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.quiz-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quiz-option {
  flex: 0 0 calc(50% - 8rpx);
  background: #F8F9FA;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #636E72;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.quiz-option.active {
  background: #E8E5FF;
  border-color: #6C5CE7;
  color: #6C5CE7;
  font-weight: 600;
}

.quiz-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F8F9FA;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #95A5A6;
  margin-top: 12rpx;
}
