<!--pages/lifestyle/lifestyle.wxml-->
<view class="container lifestyle-page">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-fill" style="width: 66.67%;"></view>
  </view>

  <!-- 页面标题 -->
  <view class="page-header">
    <view class="page-title">生活档位</view>
    <view class="page-subtitle">期望的生活水平</view>
    <view class="step-indicator">4/6</view>
  </view>

  <!-- 表单内容 -->
  <view class="form-container">
    <!-- 基础生活水平 -->
    <view class="input-group card">
      <view class="input-label">
        🏠 家庭基础生活水平
        <text class="input-required">*</text>
      </view>
      <view class="lifestyle-grid">
        <view class="lifestyle-item {{lifeLevel === '极简' ? 'active' : ''}}" bindtap="selectLifeLevel" data-level="极简">
          <view class="lifestyle-emoji">🌱</view>
          <view class="lifestyle-title">极简</view>
          <view class="lifestyle-desc">节约型</view>
        </view>
        <view class="lifestyle-item {{lifeLevel === '基本' ? 'active' : ''}}" bindtap="selectLifeLevel" data-level="基本">
          <view class="lifestyle-emoji">🏡</view>
          <view class="lifestyle-title">基本</view>
          <view class="lifestyle-desc">温饱型</view>
        </view>
        <view class="lifestyle-item {{lifeLevel === '舒适' ? 'active' : ''}}" bindtap="selectLifeLevel" data-level="舒适">
          <view class="lifestyle-emoji">🌟</view>
          <view class="lifestyle-title">舒适</view>
          <view class="lifestyle-desc">小康型</view>
        </view>
        <view class="lifestyle-item {{lifeLevel === '富裕' ? 'active' : ''}}" bindtap="selectLifeLevel" data-level="富裕">
          <view class="lifestyle-emoji">💎</view>
          <view class="lifestyle-title">富裕</view>
          <view class="lifestyle-desc">宽裕型</view>
        </view>
        <view class="lifestyle-item {{lifeLevel === '奢侈' ? 'active' : ''}}" bindtap="selectLifeLevel" data-level="奢侈">
          <view class="lifestyle-emoji">👑</view>
          <view class="lifestyle-title">奢侈</view>
          <view class="lifestyle-desc">高端型</view>
        </view>
      </view>
      <view class="lifestyle-price">约 {{lifeLevelPrice}}/月/人</view>
    </view>

    <!-- 是否请育儿嫂 -->
    <view class="input-group card">
      <view class="input-label">
        👩 0-3岁是否请育儿嫂
      </view>
      <view class="radio-group">
        <view class="radio-item {{needNanny === false ? 'active' : ''}}" bindtap="selectNanny" data-value="{{false}}">
          不请
        </view>
        <view class="radio-item {{needNanny === true ? 'active' : ''}}" bindtap="selectNanny" data-value="{{true}}">
          请育儿嫂
        </view>
      </view>
      <view class="input-hint" wx:if="{{needNanny}}">育儿嫂费用约 8千-1.2万/月</view>
    </view>

    <!-- 育儿嫂年限 -->
    <view class="input-group card" wx:if="{{needNanny}}">
      <view class="input-label">
        打算请几年
      </view>
      <view class="radio-group">
        <view class="radio-item {{nannyYears === 1 ? 'active' : ''}}" bindtap="selectNannyYears" data-years="1">
          1年
        </view>
        <view class="radio-item {{nannyYears === 2 ? 'active' : ''}}" bindtap="selectNannyYears" data-years="2">
          2年
        </view>
        <view class="radio-item {{nannyYears === 3 ? 'active' : ''}}" bindtap="selectNannyYears" data-years="3">
          3年
        </view>
      </view>
    </view>

    <!-- 生活费用说明 -->
    <view class="info-card">
      <view class="info-title">💡 生活费用包含</view>
      <view class="info-list">
        <text class="info-item">• 吃饭、穿衣</text>
        <text class="info-item">• 日常交通</text>
        <text class="info-item">• 娱乐休闲</text>
        <text class="info-item">• 医疗保健</text>
        <text class="info-item">• 家居家政</text>
      </view>
    </view>
  </view>

  <!-- 按钮组 -->
  <view class="btn-group">
    <view class="btn-secondary" bindtap="prevStep">
      ← 上一步
    </view>
    <view class="btn-primary" bindtap="nextStep">
      下一步 →
    </view>
  </view>
</view>
