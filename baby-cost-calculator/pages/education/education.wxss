/* pages/education/education.wxss */
.education-page {
  padding-top: 80rpx;
}

.stage-selector {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.stage-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F8F9FA;
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.stage-item.active {
  background: #E8E5FF;
  border-color: #6C5CE7;
}

.stage-title {
  font-size: 28rpx;
  color: #2D3436;
  font-weight: 600;
}

.stage-item.active .stage-title {
  color: #6C5CE7;
}

.stage-price {
  font-size: 24rpx;
  color: #95A5A6;
}

.stage-item.active .stage-price {
  color: #6C5CE7;
}

.level-slider {
  margin-top: 20rpx;
}

.level-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.level-label {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #95A5A6;
  padding: 16rpx 8rpx;
  background: #F8F9FA;
  margin: 0 4rpx;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.level-label.active {
  background: #6C5CE7;
  color: white;
  font-weight: 600;
  transform: scale(1.1);
}

.level-price {
  text-align: center;
  font-size: 32rpx;
  color: #6C5CE7;
  font-weight: 600;
  margin-top: 20rpx;
}
