/**app.wxss**/
page {
  background-color: #F5F6FA;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.container {
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 通用按钮样式 */
.btn-primary {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  color: white;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.3);
  margin-top: 60rpx;
}

.btn-primary:active {
  opacity: 0.8;
  transform: translateY(2rpx);
}

/* 通用卡片样式 */
.card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 通用标题样式 */
.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 20rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #636E72;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

/* 输入框样式 */
.input-group {
  margin-bottom: 40rpx;
}

.input-label {
  font-size: 28rpx;
  color: #2D3436;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.input-required {
  color: #FF6B6B;
  margin-left: 8rpx;
}

/* 选择器样式 */
.picker {
  background: #F8F9FA;
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #2D3436;
}

/* 单选/多选样式 */
.radio-group, .checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.radio-item, .checkbox-item {
  flex: 0 0 calc(50% - 10rpx);
  background: #F8F9FA;
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #636E72;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.radio-item.active, .checkbox-item.active {
  background: #E8E5FF;
  border-color: #6C5CE7;
  color: #6C5CE7;
  font-weight: 600;
}

/* 进度条 */
.progress-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 8rpx;
  background: #E8E5FF;
  z-index: 1000;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7 0%, #A29BFE 100%);
  transition: width 0.3s;
}
